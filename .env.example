# 复制为 .env 后填写（勿提交真实 token）
# 初始化方式见 tushare_init.py（唯一标准入口）:
#   import tushare as ts
#   pro = ts.pro_api(TUSHARE_TOKEN)
#   pro._DataApi__http_url = "https://a.sszhixia.cn/"
TUSHARE_TOKEN=your_token_here
TUSHARE_HTTP_URL=https://a.sszhixia.cn/

# ── 日跑结果推送（可选；留空不推送；仅 https；详见 ab_screener/operations/daily_notify.py）──
# AB_NOTIFY_WEBHOOK_KIND=wecom / dingtalk / feishu / generic
AB_NOTIFY_WEBHOOK_URL=
AB_NOTIFY_WEBHOOK_KIND=wecom
# 1 = 成功也推送；默认只推送失败
AB_NOTIFY_ON_SUCCESS=0

# ── AI 解读层（独立于 Tushare；填写一种，详见 docs/AI-MODEL-SETUP.md）──
# AI_PROVIDER=deepseek / openai / ollama；留空则选择已配置项。
AI_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
